{
  "name": "dsh-evolve-fusion",
  "version": "0.1.0",
  "description": "Fusion: gate-fused multi-source context before mutate; dual memory commit after evaluate. Companion plugin for dsh-evolve-loop (does not modify upstream).",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "tasks",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "fusion-run": "./bin/fusion-run.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "scripts": {
    "start": "node bin/fusion-run.js --clean",
    "start:baseline": "node bin/fusion-run.js --mode baseline --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:mock": "node examples/mock-evolve-run.js"
  },

  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.2.0",
    "dsh-evolve-loop": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "dsh-evolve-loop": { "optional": true }
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },

  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ddddwrrert/Fusion.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "evolve",
    "fusion",
    "information-fusion",
    "organon"
  ]
}
